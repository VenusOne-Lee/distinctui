  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Bricolage Grotesque",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "size": {
