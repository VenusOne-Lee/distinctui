{
  "$description": "distinctUI tokens in the W3C Design Tokens format. Black, white and greys; colour only on the signature mark and ring palettes. Light only. https://distinctui.com \u00b7 MIT",
  "color": {
    "white": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Page background, text on black"
    },
    "black": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Text, primary buttons, focus ring, important borders"
    },
    "grey": {
      "50": {
        "$type": "color",
        "$value": "#fafafa",
        "$description": "Notes and panels inside white"
      },
      "100": {
        "$type": "color",
        "$value": "#f2f2f2",
        "$description": "Image placeholders, hover fills, soft badges"
      },
      "200": {
        "$type": "color",
        "$value": "#e5e5e5",
        "$description": "Hairlines, card and input borders"
      },
      "400": {
        "$type": "color",
        "$value": "#a3a3a3",
        "$description": "Placeholders and decoration only (2.5:1)"
      },
      "600": {
        "$type": "color",
        "$value": "#6b6b6b",
        "$description": "Secondary text (5.3:1)"
      },
      "800": {
        "$type": "color",
        "$value": "#262626",
        "$description": "Long body text inside cards"
      }
    },
    "signature": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Your one colour. Set it once; it only appears on the mark."
    }
  },
