  "radius": {
    "input": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Inputs on longer forms"
    },
    "note": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Grey note inside a card"
    },
    "panel": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Panels, choice cards, problems banner"
    },
    "card": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Cards"
    },
    "menu": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Floating menu, status notice"
    },
    "feature": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "The one feature card"
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Buttons, tabs, badges, one-line fields, the mark"
    }
  },
  "shadow": {
    "float": {
      "$type": "shadow",
      "$value": {
        "color": "#00000014",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "30px",
        "spread": "0px"
      },
      "$description": "Floating menus and dialogs only"
    }
  },
  "border": {
    "hairline": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "grey-200"
    },
    "strong": {
      "$type": "dimension",
      "$value": "1.5px",
      "$description": "black: feature card, status, invalid field"
    }
  },
  "size": {
    "page": {
      "$type": "dimension",
      "$value": "1152px"
    },
    "read": {
      "$type": "dimension",
      "$value": "672px"
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "Press, hover"
    },
    "base": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "Tabs, menus, fields"
    },
    "slow": {
      "$type": "duration",
      "$value": "480ms",
      "$description": "Reveals, rings drawing in"
    },
    "live": {
      "$type": "duration",
      "$value": "700ms",
      "$description": "Dashed to solid, going live"
    }
  },
  "mark": {
    "ring": {
      "$type": "number",
      "$value": 0.06,
      "$description": "Ring width as a share of the mark's size"
    },
    "gap": {
      "$type": "number",
      "$value": 0.06,
      "$description": "Gap between ring and face"
    },
    "plain": {
      "$type": "number",
      "$value": 0.035,
      "$description": "Plain black ring width"
    }
  },
  "easing": {
    "settle": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Default: settle"
    },
    "pop": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        1.5,
        0.5,
        1
      ],
      "$description": "Going live only"
    }
  }
}
