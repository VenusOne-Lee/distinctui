{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "672px",
			"wideSize": "1152px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "black", "name": "Black", "color": "#000000" },
				{ "slug": "grey-50", "name": "Grey 50", "color": "#fafafa" },
				{ "slug": "grey-100", "name": "Grey 100", "color": "#f2f2f2" },
				{ "slug": "grey-200", "name": "Grey 200", "color": "#e5e5e5" },
				{ "slug": "grey-400", "name": "Grey 400", "color": "#a3a3a3" },
				{ "slug": "grey-600", "name": "Grey 600", "color": "#6b6b6b" },
				{ "slug": "grey-800", "name": "Grey 800", "color": "#262626" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "bricolage",
					"name": "Bricolage Grotesque",
					"fontFamily": "\"Bricolage Grotesque\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/BricolageGrotesque.ttf" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace (code only)",
					"fontFamily": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Badge", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Meta", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Lede", "size": "1.125rem", "fluid": false },
				{ "slug": "x-large", "name": "Card title", "size": "1.25rem", "fluid": false },
				{ "slug": "xx-large", "name": "Card headline", "size": "1.625rem", "fluid": false },
				{ "slug": "section", "name": "Section", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } },
				{ "slug": "page", "name": "Page title", "size": "3.375rem", "fluid": { "min": "2.25rem", "max": "3.375rem" } },
				{ "slug": "hero", "name": "Hero", "size": "4.75rem", "fluid": { "min": "2.5rem", "max": "4.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "4", "size": "0.25rem" },
				{ "slug": "20", "name": "8", "size": "0.5rem" },
				{ "slug": "30", "name": "12", "size": "0.75rem" },
				{ "slug": "40", "name": "16", "size": "1rem" },
				{ "slug": "50", "name": "24", "size": "1.5rem" },
				{ "slug": "60", "name": "32", "size": "2rem" },
				{ "slug": "70", "name": "56", "size": "3.5rem" },
				{ "slug": "80", "name": "Section", "size": "clamp(5rem, 10vw, 7rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "float", "name": "Float (menus only)", "shadow": "0 8px 30px rgba(0, 0, 0, 0.08)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"signature": "#1f3bff",
			"ring": {
				"1": "#1f3bff",
				"2": "#ff4f1f",
				"3": "#7a2cff",
				"4": "#e8a800",
				"5": "#000000"
			},
			"radius": {
				"note": "12px",
				"input": "14px",
				"panel": "16px",
				"card": "22px",
				"menu": "24px",
				"feature": "28px",
				"pill": "9999px"
			},
			"duration": {
				"fast": "120ms",
				"base": "200ms",
				"slow": "480ms",
				"live": "700ms"
			},
			"ease": {
				"settle": "cubic-bezier(0.2, 0, 0, 1)",
				"pop": "cubic-bezier(0.3, 1.5, 0.5, 1)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--bricolage)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"bottom": "0px",
				"left": "clamp(16px, 4vw, 24px)",
				"right": "clamp(16px, 4vw, 24px)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--black)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--black)", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--black)" },
				"typography": {
					"fontWeight": "300",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.08"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--page)",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.04"
				}
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--section)" }
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.15"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700", "letterSpacing": "0", "lineHeight": "1.45" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "700", "letterSpacing": "0", "lineHeight": "1.45" }
			},
			"button": {
				"border": { "radius": "9999px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--black)" },
				"color": {
					"background": "var(--wp--preset--color--black)",
					"text": "var(--wp--preset--color--white)"
				},
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.25",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--grey-800)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": { "outline": { "color": "var(--wp--preset--color--black)", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--grey-600)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"cite": {
				"color": { "text": "var(--wp--preset--color--grey-600)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontStyle": "normal" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700", "letterSpacing": "-0.01em" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem" },
				"elements": { "link": { "typography": { "textDecoration": "none" }, ":hover": { "typography": { "textDecoration": "underline" } } } }
			},
			"core/post-title": {
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--grey-600)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--grey-600)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-author-name": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--grey-800)" }
			},
			"core/separator": {
				"border": { "color": "var(--wp--preset--color--grey-200)", "width": "1px 0 0 0", "style": "solid" },
				"color": { "text": "var(--wp--preset--color--grey-200)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--black)", "width": "2px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"core/pullquote": {
				"border": { "top": { "color": "var(--wp--preset--color--black)", "width": "1.5px", "style": "solid" }, "bottom": { "color": "var(--wp--preset--color--black)", "width": "1.5px", "style": "solid" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "300", "letterSpacing": "-0.03em", "lineHeight": "1.2" }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--grey-50)", "text": "var(--wp--preset--color--black)" },
				"border": { "color": "var(--wp--preset--color--grey-200)", "width": "1px", "style": "solid", "radius": "16px" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.25rem", "right": "1.25rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)", "lineHeight": "1.6" }
			},
			"core/preformatted": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/image": {
				"border": { "radius": "22px" }
			},
			"core/post-featured-image": {
				"border": { "radius": "22px" },
				"color": { "background": "var(--wp--preset--color--grey-100)" }
			},
			"core/table": {
				"typography": { "fontSize": "0.9375rem" }
			},
			"core/search": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"core/query-pagination": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			},
			"core/comment-date": {
				"color": { "text": "var(--wp--preset--color--grey-600)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/comment-author-name": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (no title)", "postTypes": [ "page" ] }
	]
}
