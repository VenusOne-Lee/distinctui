{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "distinctUI+ with the big plugins",
		"author": "distinctui",
		"description": "Installs the theme and distinctUI+ from this branch, with WooCommerce, Yoast SEO, Contact Form 7 and WP Super Cache, then runs tests/playground/dui-test.php."
	},
	"landingPage": "/wp-content/plugins/distinctui-plus/tests/playground/dui-test.php",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/VenusOne-Lee/distinctui",
				"ref": "claude/project-thread-rnltxn",
				"refType": "branch",
				"path": "wordpress/distinctui"
			},
			"options": {
				"activate": true,
				"targetFolderName": "distinctui"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "wordpress-seo"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "contact-form-7"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "wp-super-cache"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/VenusOne-Lee/distinctui",
				"ref": "claude/project-thread-rnltxn",
				"refType": "branch",
				"path": "wordpress/distinctui-plus"
			},
			"options": {
				"activate": true,
				"targetFolderName": "distinctui-plus"
			}
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"DUI_PLUS_DEV": true,
				"DUI_PLUS_PLAYGROUND_TEST": true
			}
		}
	]
}