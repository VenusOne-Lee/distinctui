{
  "name": "@distinctui/css",
  "version": "0.2.0",
  "description": "Calm black, white and grey interfaces with one signature mark in one colour. The design system behind Version One.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://distinctui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VenusOne-Lee/distinctui.git"
  },
  "keywords": [
    "design-system",
    "css",
    "tailwind",
    "claude",
    "skill",
    "monochrome"
  ],
  "style": "skills/distinctui/assets/distinctui.css",
  "unpkg": "skills/distinctui/assets/distinctui.css",
  "jsdelivr": "skills/distinctui/assets/distinctui.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./skills/distinctui/assets/distinctui.css",
    "./distinctui.css": "./skills/distinctui/assets/distinctui.css",
    "./tailwind.css": "./skills/distinctui/assets/tailwind.css",
    "./distinctui.js": "./skills/distinctui/assets/distinctui.js",
    "./tokens.json": "./skills/distinctui/assets/tokens.json",
    "./stageshow-look.css": "./skills/distinctui/assets/stageshow-look.css",
    "./icons.svg": "./skills/distinctui/assets/icons.svg",
    "./rules.json": "./skills/distinctui/assets/rules.json",
    "./check.js": "./skills/distinctui/assets/check.js",
    "./compose.js": "./skills/distinctui/assets/compose.js"
  },
  "files": [
    "skills/distinctui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/swift-tokens.mjs --check && node scripts/build-site.mjs",
    "tokens": "node scripts/swift-tokens.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wrangler": "^4.0.0"
  }
}
